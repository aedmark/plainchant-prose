{
  "name": "plainchant-prose",
  "version": "0.1.0",
  "description": "An offline-first plain-text long-form writer with Tauri desktop support.",
  "main": "index.html",
  "scripts": {
    "test": "node test/run.js",
    "test:browser": "node test/browser.js && node test/store-browser.js",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "roundtrip": "node tools/roundtrip.js",
    "serve": "python3 -m http.server 8081",
    "tauri:dev": "cargo run --manifest-path src-tauri/Cargo.toml",
    "tauri:build": "cargo build --release --manifest-path src-tauri/Cargo.toml"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18"
  },
  "private": true
}
